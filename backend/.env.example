PORT=5000
NODE_ENV=development

# Pilihan Driver Database: 'sqlite' atau 'mysql'
DB_DRIVER=sqlite

# Konfigurasi SQLite
SQLITE_DB_PATH=./database/loopin.db

# Konfigurasi MySQL (Opsional, jika menggunakan MySQL / XAMPP)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=loopin_db
